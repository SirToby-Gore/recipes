# Enable rewriting engine
RewriteEngine On

# Force base path to prevent alias resolution loss on free servers
RewriteBase /

# Stop processing if the request is an actual existing file or folder
# (Allows assets, compiled CSS, and JS scripts to load directly)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all other URLs to index.php cleanly
RewriteRule ^(.*)$ index.php [QSA,L]