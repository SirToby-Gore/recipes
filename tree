```scss/abstracts/_mixins.scss
@use 'variables' as vars;

@mixin flex-center {
	display: flex;
	align-items: center;
	justify-content: center;
}

@mixin respond-to-md {
	@media (max-width: #{vars.$breakpoint-md}) {
		@content;
	}
}

@mixin card-base {
	background: vars.$bg-card;
	border: 1px solid vars.$border-color;
	border-radius: vars.$radius-md;
	box-shadow: vars.$shadow-sm;
	transition: vars.$transition-smooth;

	&:hover {
		transform: translateY(-2px);
		box-shadow: vars.$shadow-md;
	}
}

@mixin button-base($bg, $text) {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 0.6rem 1.2rem;
	font-weight: 600;
	font-size: 0.9rem;
	text-decoration: none;
	border-radius: vars.$radius-sm;
	border: none;
	cursor: pointer;
	transition: vars.$transition-smooth;
	background-color: $bg;
	color: $text;

	&:hover {
		filter: brightness(1.15);
	}
}

@mixin recipe-details() {
	.heading {
		margin-bottom: 0.25rem;
		.title, .profile-button {
			font-size: 1.25rem;
			font-weight: 700;
			color: vars.$primary-dark;
			line-height: 1.3;
		}
	}

	.sub-heading {
		margin-bottom: 1.5rem;
		.author,
		.email {
			font-size: 0.9rem;
			color: vars.$text-muted;
		}
		.author::before {
			content: 'By ';
		}
	}

	.info {
		display: flex;
		flex-direction: column;

		.time,
		.portions {
			img {
				width: 20%;
				aspect-ratio: auto;
			}
		}
	}

	.footer {
		margin-top: auto;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;

		a {
			flex: 1 1 calc(50% - 0.5rem);
			min-width: fit-content;
			text-align: center;
		}

		// Base properties for icon button formatting
		button,
		.profile-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			box-sizing: border-box;
			height: 2.5rem; // Equivalent to standard button heights

			img {
				width: 1.25rem;
				height: 1.25rem;
				display: block;
				pointer-events: none;
				transition: transform 0.2s ease;
			}

			&:hover:not(:disabled) {
				img {
					transform: scale(1.1);
				}
			}

			&:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}
		}

		.like-button {
			@include button-base(vars.$primary-light, vars.$primary-dark);
			width: 2.5rem;
			flex: 0 0 auto;
			order: 1;

			&.liked {
				background-color: #ffeef0;
				border-color: #ffb8c2;
				img {
					filter: invert(32%) sepia(85%) saturate(2852%) hue-rotate(338deg) brightness(98%) contrast(89%);
				}
			}
		}

		.favourite-button {
			@include button-base(rgba(vars.$primary-medium, 0.1), vars.$primary-medium);
			width: 2.5rem;
			flex: 0 0 auto;
			order: 2;

			&.favourited {
				background-color: #e8f0fe;
				border-color: #b3d1ff;
				img {
					filter: invert(38%) sepia(91%) saturate(1651%) hue-rotate(202deg) brightness(96%) contrast(93%);
				}
			}
		}

		.email-button {
			@include button-base(rgba(vars.$primary-medium, 0.1), vars.$primary-medium);
		}

		.basket-controls-context {
			display: flex;
			align-items: center;
			flex: 1 1 100%;
			order: 3;

			.add-button {
				@include button-base(vars.$primary-light, vars.$primary-dark);
				width: 100%;

				&.adding {
					background-color: #fef08a;
					border-color: #fde047;
				}

				&.added {
					background-color: #dcfce7;
					border-color: #86efac;
					img {
						filter: invert(41%) sepia(74%) saturate(415%) hue-rotate(94deg) brightness(95%) contrast(91%);
					}
				}
			}

			.basket-management-group {
				display: flex;
				align-items: center;
				border: 1px solid vars.$primary-medium;
				border-radius: 0.25rem;
				background-color: #ffffff;
				height: 2.5rem;
				overflow: hidden;
				width: 100%;
				box-sizing: border-box;

				.decrement-btn,
				.increment-btn,
				.remove-btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					height: 100%;
					text-decoration: none;
					color: vars.$primary-dark;
					font-size: 0.875rem;
					font-weight: bold;
					background-color: rgba(vars.$primary-medium, 0.05);
					transition: background-color 0.15s ease;
					box-sizing: border-box;
					padding: 0 0.75rem;

					&:hover {
						background-color: rgba(vars.$primary-medium, 0.15);
					}
				}

				.recipe-count-display {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					flex: 1;
					padding-left: 1rem;
					padding-right: 1rem;
					height: 100%;
					font-size: 0.875rem;
					font-weight: 600;
					border-left: 1px solid vars.$primary-medium;
					border-right: 1px solid vars.$primary-medium;
					background-color: #ffffff;
					color: vars.$primary-dark;
					box-sizing: border-box;
				}

				.remove-btn {
					font-size: 0.75rem;
					color: #e63946;
					font-weight: normal;
					border-left: 1px solid vars.$primary-medium;

					&:hover {
						background-color: #ffeef0;
					}
				}
			}
		}

		.view-recipe-button,
		.profile-button {
			@include button-base($bg: vars.$primary-medium, $text: #ffffff);
			flex: 1 1 100%;
			order: 4;
		}
	}
}

